# Copy to demo/env.local.sh (gitignored) and fill in your gateway URL.
# The governed LLM endpoint fronted by the Flex Gateway route this policy is applied to.
export C3_GW_URL="https://<omni-gw-small-host>/<route>/v1/chat/completions"

# A caller identity header value (feeds the deterministic sampling / cache key).
export C3_CLIENT_ID="demo-client-1"

# For the require_registration scenario: an id that IS in registeredUseCases (allowed),
# and one that is NOT (blocked). See demo/config.json.example.
export C3_REGISTERED_USE_CASE="hr-screening-2026"
export C3_UNREGISTERED_USE_CASE="rogue-hiring-bot"

# ── Real-judge run (optional) ─────────────────────────────────────────────────
# To demo against the real TypeSafe Jev judge instead of the mock, set these and
# switch demo/config.json jevProvider to "typesafe" (see README). NEVER commit the key.
# export C3_JEV_SERVICE="https://openrouter.ai"
# export C3_JEV_MODEL="~typesafe/jev-latest"
# export C3_JEV_API_KEY="sk-or-v1-..."
